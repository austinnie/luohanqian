/* 基础样式 */
.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #ffffff;
}

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  font-size: 28rpx;
  color: #666666;
}

/* 标题区域 */
.header {
  text-align: center;
  margin: 40rpx 0;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
}

.subtitle {
  font-size: 28rpx;
  color: #666666;
  margin-top: 10rpx;
}

/* 求签区域 */
.draw-area {
  display: flex;
  justify-content: center;
  margin: 60rpx 0;
}

.lotus {
  width: 180rpx;
  height: 180rpx;
}

/* 签文结果 */
.result-container {
  margin-top: 40rpx;
  background-color: #f9f9f9;
  border-radius: 16rpx;
  padding: 30rpx;
}

.sign-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.sign-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.sign-luck {
  margin-left: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: white;
}

/* 吉凶等级颜色 */
.luck-best { background-color: #4CAF50; } /* 上上签 */
.luck-good { background-color: #2196F3; } /* 上吉签 */
.luck-medium { background-color: #FFC107; color: #333; } /* 中吉签 */
.luck-neutral { background-color: #9E9E9E; } /* 中平签 */
.luck-bad { background-color: #F44336; } /* 下下签 */

/* 签文内容 */
.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-weight: bold;
  color: #333333;
  font-size: 32rpx;
  margin-bottom: 10rpx;
  display: block;
}

.section-content {
  line-height: 1.6;
  color: #555555;
  font-size: 28rpx;
}

/* 详细解析切换 */
.toggle-details {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1E88E5;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #eeeeee;
  border-bottom: 1rpx solid #eeeeee;
  margin: 30rpx 0;
}

.toggle-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 10rpx;
}

/* 详细解析内容 */
.analysis-section {
  margin-top: 20rpx;
}

.analysis-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.analysis-item {
  padding: 15rpx;
  background-color: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05);
}

.analysis-title {
  font-weight: bold;
  color: #333333;
  font-size: 28rpx;
}

.analysis-content {
  color: #666666;
  font-size: 26rpx;
  margin-top: 5rpx;
  display: block;
}

/* 调整按钮样式 */
.action-buttons {
  display: flex;
  justify-content: center; /* 居中显示 */
  margin-top: 20px;
}

.draw-again-btn {
  background-color: #f5f5f5;
  color: #333333;
  flex: 1;
}