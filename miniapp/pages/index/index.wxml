<view class="container">
  <view class="header">
    <image src="/images/logo.png" class="logo"></image>
    <text class="title">罗汉签占卜系统</text>
    <text class="subtitle">诚心求签，菩萨指点迷津</text>
  </view>
  
  <view class="menu">
    <!-- 随机求签按钮 -->
    <view class="menu-item" bindtap="goToDraw">
      <image src="/images/draw.png" class="menu-icon"></image>
      <text>随机求签</text>
    </view>   

    <!-- 求签历史按钮 -->
    <view class="menu-item" bindtap="goToHistory">
      <image src="/images/history.png" class="menu-icon"></image>
      <text>求签历史</text>
    </view>

    <!-- 新增关于页面按钮 -->
    <view class="menu-item" bindtap="goToAbout">
      <image src="/images/about.png" class="menu-icon"></image>
      <text>关于我们</text>
    </view>
  </view>
  
  <view class="footer">
    <text>心诚则灵，仅供参考</text>
  </view>
</view>