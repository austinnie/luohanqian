page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.container {
  padding: 20px;
}

.header {
  text-align: center;
  margin-bottom: 30px;
}

.header .title {
  font-size: 24px;
  font-weight: bold;
  display: block;
  margin-top: 10px;
}

.header .subtitle {
  font-size: 14px;
  color: #888;
}

/* 幸运等级颜色 */
.luck-best {
  color: #4CAF50;
}

.luck-good {
  color: #2196F3;
}

.luck-medium {
  color: #FFC107;
}

.luck-bad {
  color: #F44336;
}