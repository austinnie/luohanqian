/* pages/about/about.wxss */
.container {
  padding: 20px;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  padding: 15px;
  background-color: #fff;
  border-radius: 10px;
  margin-bottom: 20px;
}

.back {
  font-size: 20px;
  margin-right: 10px;
}

.header text {
  font-size: 18px;
  font-weight: bold;
}

.about-content {
  background-color: #fff;
  border-radius: 10px;
  padding: 20px;
}

.section {
  margin-bottom: 25px;
}

.section-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10px;
  border-left: 4px solid #07c160;
  padding-left: 10px;
}

.section-content {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
}

.contact-info {
  margin-top: 15px;
}

.contact-item {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
  padding: 10px;
  background-color: #f9f9f9;
  border-radius: 8px;
}

.contact-icon {
  width: 20px;
  height: 20px;
  margin-right: 10px;
}

.contact-text {
  font-size: 14px;
  color: #333;
}

.feature-list {
  margin-top: 10px;
}

.feature-item {
  display: block;
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.footer {
  text-align: center;
  margin-top: 30px;
  padding-top: 20px;
  border-top: 1px solid #eee;
}

.copyright {
  font-size: 12px;
  color: #999;
}