<!-- pages/signDetail/signDetail.wxml -->
<view class="container">
  <view class="header">
    <view class="back" bindtap="navigateBack">←</view>
    <text>签文详情</text>
    <view class="more">···</view>
  </view>

  <view class="sign-detail-content" wx:if="{{sign}}">
    <!-- 签文头部 -->
    <view class="sign-header">
      <text class="sign-number">{{sign.id}}</text>
      <text class="sign-luck {{getLuckClass(sign.luck)}}">
        {{formatLuckText(sign.luck)}}
      </text>
    </view>

    <!-- 签诗和总判 -->
    <view class="section">
      <text class="section-title">签诗</text>
      <text class="section-content">{{sign.poem}}</text>
    </view>

    <view class="section">
      <text class="section-title">总判</text>
      <text class="section-content">{{sign.summary}}</text>
    </view>

    <!-- 详细解析表格（采用第二张图片的样式） -->
    <view class="analysis-section">
      <view class="section-header">
        <text class="section-title">详细解析</text>
        <text class="toggle-text" bindtap="toggleAnalysis">
          {{showFullAnalysis ? '收起详细解读' : '展开详细解读'}}
        </text>
      </view>

      <view class="analysis-table" wx:if="{{showFullAnalysis}}">
        <view class="table-row" wx:for="{{analysisItems}}" wx:key="key">
          <view class="table-cell label-cell">
            <text class="analysis-label">{{item.title}}：</text>
          </view>
          <view class="table-cell content-cell">
            <text class="analysis-content">
              {{sign.analysis[item.key] || '暂无具体解签'}}
            </text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>