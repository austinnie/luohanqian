<!-- pages/history/history.wxml -->
<view class="container">
  <view class="header">
    <view class="back" bindtap="navigateBack">←</view>
    <text>求签历史</text>
    <view class="more">···</view>
  </view>


  

<!-- 修改wx:key为唯一标识 -->
<block wx:for="{{historyList}}" wx:key="*this">
  <view class="history-item" bindtap="viewSignDetail" data-sign="{{item}}">
    <view class="sign-header">
      <text class="sign-num">{{item.id}}</text>
      <text class="sign-time">{{item.time}}</text>
    </view>
    <view class="sign-poem">{{item.poem}}</view>
    <view class="sign-summary">{{item.summary}}</view>
    
    <!-- 添加数据完整性检查 -->
    <view class="view-detail-btn" wx:if="{{item.num && item.poem}}">
      <text>查看详细解签</text>
    </view>
    <view class="view-detail-btn disabled" wx:else>
      <text>签文数据异常</text>
    </view>
  </view>
</block>
  

  <view class="footer" wx:if="{{historyList.length > 0}}">
    <button class="clear-btn" bindtap="showClearConfirm">清空历史记录</button>
  </view>
</view>