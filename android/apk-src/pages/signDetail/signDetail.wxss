/* pages/signDetail/signDetail.wxss */
.analysis-table {
  background-color: #fff;
  border-radius: 8px;
  padding: 15px;
  margin-top: 10px;
}

.table-row {
  display: flex;
  margin-bottom: 12px;
  align-items: flex-start;
}

.label-cell {
  width: 80px;
  flex-shrink: 0;
}

.content-cell {
  flex: 1;
}

.analysis-label {
  font-weight: bold;
  color: #333;
  font-size: 14px;
}

.analysis-content {
  color: #444;
  line-height: 1.6;
  font-size: 14px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.toggle-text {
  color: #007aff;
  font-size: 14px;
}